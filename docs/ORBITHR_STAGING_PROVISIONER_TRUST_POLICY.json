{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDedicatedOperatorAssumeRoleWithMFA",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::402545554824:user/orbithr-staging-operator"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "402545554824"
        },
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
