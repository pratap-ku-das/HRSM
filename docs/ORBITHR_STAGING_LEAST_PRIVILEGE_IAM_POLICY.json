{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowStagingEC2RegionalDescribeAndMetadata",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeVolumes",
        "ec2:DescribeTags",
        "ec2:DescribeImages",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVpcAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "AllowStagingVPCNetworkingLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "AllowStagingEC2LaunchInstanceAndVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:402545554824:instance/*",
        "arn:aws:ec2:eu-north-1:402545554824:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "ec2:InstanceType": "t3.small",
          "aws:RequestTag/Environment": "Staging",
          "aws:RequestTag/Project": "OrbitHR"
        }
      }
    },
    {
      "Sid": "AllowStagingEC2LaunchVolumeScoped",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:402545554824:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "aws:RequestTag/Environment": "Staging",
          "aws:RequestTag/Project": "OrbitHR"
        }
      }
    },
    {
      "Sid": "AllowStagingEC2LaunchNetworkInterface",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:402545554824:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "AllowStagingEC2LaunchSubnetAndSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:402545554824:subnet/*",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "aws:ResourceTag/Environment": "Staging"
        }
      }
    },
    {
      "Sid": "AllowStagingEC2OfficialAMI",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:eu-north-1::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Owner": "amazon"
        }
      }
    },
    {
      "Sid": "AllowStagingEC2TerminateInstance",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:eu-north-1:402545554824:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "AllowStagingEC2DeleteVolumeScoped",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVolume"
      ],
      "Resource": "arn:aws:ec2:eu-north-1:402545554824:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "aws:ResourceTag/Environment": "Staging"
        }
      }
    },
    {
      "Sid": "AllowStagingRDSDescribeAndMetadata",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeDBInstances",
        "rds:DescribeOrderableDBInstanceOptions",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBInstanceAutomatedBackups",
        "rds:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "AllowStagingRDSScopedLifecycle",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBSubnetGroup",
        "rds:DeleteDBSubnetGroup",
        "rds:CreateDBInstance",
        "rds:DeleteDBInstance",
        "rds:AddTagsToResource",
        "rds:DeleteDBInstanceAutomatedBackup",
        "rds:DeleteDBSnapshot"
      ],
      "Resource": [
        "arn:aws:rds:eu-north-1:402545554824:subgrp:orbithr-staging-db-subnet-group",
        "arn:aws:rds:eu-north-1:402545554824:db:hrms-database-staging",
        "arn:aws:rds:eu-north-1:402545554824:auto-backup:*",
        "arn:aws:rds:eu-north-1:402545554824:snapshot:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "AllowStagingS3BucketManagement",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:PutLifecycleConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:AbortMultipartUpload",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::orbithr-staging-deployments-402545554824",
        "arn:aws:s3:::orbithr-staging-deployments-402545554824/*"
      ]
    },
    {
      "Sid": "AllowStagingIAMRoleReadAndPassRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetInstanceProfile",
        "iam:ListRoleTags",
        "iam:PassRole",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::402545554824:role/OrbitHR-EC2-Staging-Role",
        "arn:aws:iam::402545554824:instance-profile/OrbitHR-EC2-Staging-Profile"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowStagingIAMHostPolicyLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:TagPolicy"
      ],
      "Resource": "arn:aws:iam::402545554824:policy/OrbitHR-EC2-Staging-Host-Policy"
    },
    {
      "Sid": "AllowStagingIAMPolicyAttachmentRestricted",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::402545554824:role/OrbitHR-EC2-Staging-Role",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
            "arn:aws:iam::402545554824:policy/OrbitHR-EC2-Staging-Host-Policy"
          ]
        }
      }
    },
    {
      "Sid": "AllowStagingIAMListRolesGlobal",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowStagingSSMParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters"
      ],
      "Resource": "arn:aws:ssm:eu-north-1:402545554824:parameter/orbithr/staging/*"
    },
    {
      "Sid": "AllowStagingRekognition",
      "Effect": "Allow",
      "Action": [
        "rekognition:CreateCollection",
        "rekognition:DeleteCollection",
        "rekognition:DescribeCollection",
        "rekognition:ListCollections"
      ],
      "Resource": [
        "arn:aws:rekognition:eu-north-1:402545554824:collection/orbithr-staging",
        "*"
      ]
    },
    {
      "Sid": "ExplicitDenyProductionEC2AndVPCComplete",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:DeleteVpc",
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:ReplaceRouteTableAssociation",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:402545554824:instance/i-068f8f1e571bc5cc6",
        "arn:aws:ec2:eu-north-1:402545554824:vpc/vpc-0f8de3bbcdc8e468f",
        "arn:aws:ec2:eu-north-1:402545554824:subnet/subnet-01b6187e3535d9049",
        "arn:aws:ec2:eu-north-1:402545554824:subnet/subnet-04a75597ba2f7df9c",
        "arn:aws:ec2:eu-north-1:402545554824:subnet/subnet-0d091cd08943c5f4c",
        "arn:aws:ec2:eu-north-1:402545554824:route-table/rtb-07c18af3192efc4a4",
        "arn:aws:ec2:eu-north-1:402545554824:internet-gateway/igw-0ed6fdc9fba5a0d37",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-0401226ecafcf0f3a",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-0c0e2eb3683a9d89a",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-0f99206eef341303a",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-072db468ca82eb938"
      ]
    },
    {
      "Sid": "ExplicitDenyProductionRDSAndSnapshotsComplete",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance",
        "rds:ModifyDBInstance",
        "rds:RebootDBInstance",
        "rds:DeleteDBSnapshot",
        "rds:ModifyDBSnapshot",
        "rds:DeleteDBInstanceAutomatedBackup",
        "rds:DeleteDBSubnetGroup",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:rds:eu-north-1:402545554824:db:hrms-database",
        "arn:aws:rds:eu-north-1:402545554824:snapshot:orbithr-pre-p2-10-rc2-snapshot",
        "arn:aws:rds:eu-north-1:402545554824:snapshot:rds:hrms-database-*",
        "arn:aws:rds:eu-north-1:402545554824:subgrp:default-vpc-0f8de3bbcdc8e468f"
      ]
    },
    {
      "Sid": "ExplicitDenyProductionS3BucketComplete",
      "Effect": "Deny",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::orbithr-production-deployments-402545554824",
        "arn:aws:s3:::orbithr-production-deployments-402545554824/*"
      ]
    },
    {
      "Sid": "ExplicitDenyProductionIAMRolesAndPassRoleComplete",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::402545554824:role/OrbitHR-EC2-Role",
        "arn:aws:iam::402545554824:role/OrbitHR-GitHub-Deploy"
      ]
    }
  ]
}
