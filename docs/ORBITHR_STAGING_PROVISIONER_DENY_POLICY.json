{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExplicitDenyProductionEC2AndVPCComplete",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:DeleteVpc",
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:ReplaceRouteTableAssociation",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:402545554824:instance/i-068f8f1e571bc5cc6",
        "arn:aws:ec2:eu-north-1:402545554824:vpc/vpc-0f8de3bbcdc8e468f",
        "arn:aws:ec2:eu-north-1:402545554824:subnet/subnet-01b6187e3535d9049",
        "arn:aws:ec2:eu-north-1:402545554824:subnet/subnet-04a75597ba2f7df9c",
        "arn:aws:ec2:eu-north-1:402545554824:subnet/subnet-0d091cd08943c5f4c",
        "arn:aws:ec2:eu-north-1:402545554824:route-table/rtb-07c18af3192efc4a4",
        "arn:aws:ec2:eu-north-1:402545554824:internet-gateway/igw-0ed6fdc9fba5a0d37",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-0401226ecafcf0f3a",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-0c0e2eb3683a9d89a",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-0f99206eef341303a",
        "arn:aws:ec2:eu-north-1:402545554824:security-group/sg-072db468ca82eb938"
      ]
    },
    {
      "Sid": "ExplicitDenyProductionRDSAndSnapshotsComplete",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance",
        "rds:ModifyDBInstance",
        "rds:RebootDBInstance",
        "rds:DeleteDBSnapshot",
        "rds:ModifyDBSnapshot",
        "rds:DeleteDBInstanceAutomatedBackup",
        "rds:DeleteDBSubnetGroup",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:rds:eu-north-1:402545554824:db:hrms-database",
        "arn:aws:rds:eu-north-1:402545554824:snapshot:orbithr-pre-p2-10-rc2-snapshot",
        "arn:aws:rds:eu-north-1:402545554824:snapshot:rds:hrms-database-*",
        "arn:aws:rds:eu-north-1:402545554824:subgrp:default-vpc-0f8de3bbcdc8e468f"
      ]
    },
    {
      "Sid": "ExplicitDenyProductionS3BucketComplete",
      "Effect": "Deny",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::orbithr-production-deployments-402545554824",
        "arn:aws:s3:::orbithr-production-deployments-402545554824/*"
      ]
    },
    {
      "Sid": "ExplicitDenyProductionIAMRolesAndPassRoleComplete",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::402545554824:role/OrbitHR-EC2-Role",
        "arn:aws:iam::402545554824:role/OrbitHR-GitHub-Deploy"
      ]
    }
  ]
}
