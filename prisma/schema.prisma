// Prisma Schema for Multi-Tenant Enterprise HRMS
// Connected to PostgreSQL through the server-only DATABASE_URL.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  PAYROLL_ADMIN
  MANAGER
  DEPT_HEAD
  EMPLOYEE
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum PermissionScope {
  ALL_COMPANY
  BRANCH
  DEPARTMENT
  TEAM
  SELF
}

enum EmployeeStatus {
  ACTIVE
  ON_PROBATION
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum EmployeeOnboardingStatus {
  DRAFT
  PERSONAL_DETAILS
  DOCUMENT_DETAILS
  SALARY_DETAILS
  FACE_AUTHENTICATION
  ADDITIONAL_DETAILS
  REVIEW
  COMPLETED
  INVITED
  ACTIVE
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceSource {
  WEB_ADMIN
  MOBILE_FACE
  BIOMETRIC_DEVICE
  SYSTEM_AUTO
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  ATTENDANCE_REVIEW
  ATTENDANCE_LOCKED
  ATTENDANCE_FINALIZED
  CALCULATED
  HR_REVIEW
  PENDING_APPROVAL
  FINANCE_APPROVED
  APPROVED
  LOCKED
  PAYSLIP_GENERATED
  PAYSLIPS_PUBLISHED
  BANK_EXPORTED
  PROCESSED
  PAID
  REVERSED
  REJECTED
  CANCELLED
  FAILED
}

enum SalaryComponentKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  REIMBURSEMENT
}

enum SalaryCalculationMethod {
  FIXED
  PERCENT_BASIC
  PERCENT_GROSS
}

enum SalaryRevisionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum StatutoryFilingDomain {
  EPF_ECR
  ESIC_MONTHLY
  TDS_24Q
  PROFESSIONAL_TAX
}

enum StatutoryFilingStatus {
  DRAFT
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  LOCKED
  EXPORTED
  CANCELLED
  SUPERSEDED
}

enum StatutoryFilingType {
  ORIGINAL
  REVISED
}


enum StatutoryRuleType {
  PF
  ESI
  PROFESSIONAL_TAX
  TDS
  LWF
}

enum EmployeeLoanStatus {
  DRAFT
  ACTIVE
  CLOSED
  WAIVED
}

enum TaxDeclarationStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

enum InvestmentProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SettlementStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  REVERSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReportExportStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum JobStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  AT_RISK
}

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  REVIEW
  CLOSED
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  MANAGER_REVIEWED
  HR_REVIEWED
  ACKNOWLEDGED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
  INGESTED
}

enum WorkflowModule {
  LEAVE
  EXPENSE
  ATTENDANCE_CORRECTION
  WFH
  ON_DUTY
  BUSINESS_TRAVEL
  OVERTIME
  SALARY_REVISION
  PAYROLL
  DOCUMENT
  ADVANCE
  GENERIC
}

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum WorkflowInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum WorkflowStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum WorkflowApproverType {
  USER
  ROLE
  REPORTING_MANAGER
  DEPARTMENT_HEAD
  FINANCE
}

enum WorkflowActionType {
  SUBMIT
  APPROVE
  REJECT
  COMMENT
  DELEGATE
  CANCEL
  WITHDRAW
}

enum ShiftType {
  FIXED
  FLEXIBLE
  NIGHT
  ROTATIONAL
}

enum AttendanceRequestType {
  REGULARIZATION
  WFH
  ON_DUTY
  BUSINESS_TRAVEL
  OVERTIME
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// --------------------------------------------------------
// MULTI-TENANT COMPANY / WORKSPACE
// --------------------------------------------------------
model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String
  phone     String?
  address   String?
  industry  String
  size      String
  plan      PlanTier @default(GROWTH)
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  employees                Employee[]
  departments              Department[]
  designations             Designation[]
  attendanceRecords        AttendanceRecord[]
  attendanceLocationPoints AttendanceLocationPoint[]
  leaveTypes               LeaveType[]
  leaveRequests            LeaveRequest[]
  payrollRuns              PayrollRun[]
  payslips                 Payslip[]
  jobPostings              JobPosting[]
  jobApplicants            JobApplicant[]
  goals                    PerformanceGoal[]
  assets                   Asset[]
  documents                CompanyDocument[]
  holidays                 Holiday[]
  announcements            Announcement[]
  expenses                 ExpenseClaim[]
  auditLogs                AuditLog[]
  settings                 CompanySettings?
  faceEnrollments          FaceEnrollment[]
  faceSessions             FaceVerificationSession[]
  branches                 Branch[]
  workLocations            WorkLocation[]
  teams                    Team[]
  costCenters              CostCenter[]
  employeeGrades           EmployeeGrade[]
  accessRoles              AccessRole[]
  permissions              Permission[]
  accessGrants             UserAccessGrant[]
  workflowDefinitions      WorkflowDefinition[]
  workflowInstances        WorkflowInstance[]
  workflowDelegations      WorkflowDelegation[]
  shiftTemplates           ShiftTemplate[]
  attendancePolicies       AttendancePolicy[]
  shiftAssignments         ShiftAssignment[]
  attendanceRequests       AttendanceRequest[]
  attendanceLocks          AttendancePeriodLock[]
  salaryStructures         SalaryStructure[]
  salaryRevisions          EmployeeSalaryRevision[]
  statutoryRules           StatutoryRuleVersion[]
  employeeLoans            EmployeeLoan[]
  payrollAdjustments       PayrollAdjustment[]
  taxDeclarations          TaxDeclaration[]
  form16Documents          Form16Document[]
  settlements              FullFinalSettlement[]
  notificationTemplates    NotificationTemplate[]
  notifications            Notification[]
  notificationDeliveries   NotificationDelivery[]
  savedReports             SavedReport[]
  reportExports            ReportExport[]
  employeeDocuments        EmployeeDocument[]
  loginAttempts            LoginAttempt[]
  aiInteractions           AiInteraction[]
  performanceCycles        PerformanceCycle[]
  performanceReviews       PerformanceReview[]
  serviceRequests          EmployeeServiceRequest[]
  employeeOnboardings      EmployeeOnboarding[]
  payrollAttendanceReviews PayrollAttendanceReview[]
  payrollAttendanceChanges PayrollAttendanceChange[]
  employeeStatutoryProfiles EmployeeStatutoryProfile[]
  tdsChallans              TdsChallan[]
  statutoryFilings         StatutoryFiling[]
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------
model User {
  id              String    @id @default(uuid())
  companyId       String
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  tokenVersion    Int       @default(0)
  fullName        String
  role            UserRole  @default(COMPANY_ADMIN)
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee                Employee?
  refreshTokens           RefreshToken[]
  actionTokens            ActionToken[]
  faceEnrollmentsCreated  FaceEnrollment[]         @relation("FaceEnrollmentCreator")
  accessGrants            UserAccessGrant[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices             PushDevice[]
  mfaMethod               MfaMethod?
  reviewsAsReviewer       PerformanceReview[]      @relation("PerformanceReviewer")
  savedReports            SavedReport[]
  reportExports           ReportExport[]
  aiInteractions          AiInteraction[]

  @@index([companyId])
}

enum ActionTokenType {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  deviceName String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model ActionToken {
  id        String          @id @default(uuid())
  userId    String
  type      ActionTokenType
  tokenHash String          @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model EmailDelivery {
  id             String              @id @default(uuid())
  companyId      String
  userId         String?
  employeeId     String?
  idempotencyKey String              @unique
  messageType    String
  recipient      String
  providerId     String?
  status         EmailDeliveryStatus @default(PENDING)
  attemptCount   Int                 @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([companyId, status])
  @@index([nextAttemptAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  companyId    String
  userId       String
  key          String
  operation    String
  responseJson Json
  statusCode   Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([companyId, userId, key, operation])
  @@index([expiresAt])
}

// --------------------------------------------------------
// EMPLOYEE PROFILE (360-DEGREE LIFECYCLE)
// --------------------------------------------------------
model Employee {
  id                        String         @id @default(uuid())
  companyId                 String
  userId                    String?        @unique
  employeeCode              String
  firstName                 String
  lastName                  String
  email                     String
  phone                     String?
  avatarUrl                 String?
  dateOfBirth               DateTime?      @db.Date
  gender                    String?
  departmentId              String
  designationId             String
  reportingManagerId        String?
  branchId                  String?
  workLocationId            String?
  teamId                    String?
  costCenterId              String?
  employeeGradeId           String?
  dateOfJoining             DateTime       @db.Date
  confirmationDate          DateTime?      @db.Date
  probationEndDate          DateTime?      @db.Date
  resignationDate           DateTime?      @db.Date
  lastWorkingDay            DateTime?      @db.Date
  employmentType            EmploymentType @default(FULL_TIME)
  status                    EmployeeStatus @default(ACTIVE)
  workLocation              String?
  workdayGpsTrackingEnabled Boolean        @default(false)

  // Compensation breakdown
  basicSalary   Float  @default(0)
  hra           Float  @default(0)
  allowances    Float  @default(0)
  providentFund Float  @default(0)
  taxDeduction  Float  @default(0)
  currency      String @default("INR")

  // Bank & Tax
  bankName      String?
  accountNumber String?
  routingOrIfsc String?
  taxIdentifier String?

  // Emergency contact
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  skills    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                     User?                     @relation(fields: [userId], references: [id])
  department               Department                @relation(fields: [departmentId], references: [id])
  designation              Designation               @relation(fields: [designationId], references: [id])
  attendanceRecords        AttendanceRecord[]
  leaveRequests            LeaveRequest[]
  payslips                 Payslip[]
  goals                    PerformanceGoal[]
  assets                   Asset[]
  expenses                 ExpenseClaim[]
  faceEnrollment           FaceEnrollment?
  faceSessions             FaceVerificationSession[]
  branch                   Branch?                   @relation(fields: [branchId], references: [id])
  location                 WorkLocation?             @relation(fields: [workLocationId], references: [id])
  team                     Team?                     @relation(fields: [teamId], references: [id])
  costCenter               CostCenter?               @relation(fields: [costCenterId], references: [id])
  employeeGrade            EmployeeGrade?            @relation(fields: [employeeGradeId], references: [id])
  reportingManager         Employee?                 @relation("EmployeeReportingLine", fields: [reportingManagerId], references: [id])
  directReports            Employee[]                @relation("EmployeeReportingLine")
  shiftAssignments         ShiftAssignment[]
  breakSessions            BreakSession[]
  attendanceRequests       AttendanceRequest[]
  salaryRevisions          EmployeeSalaryRevision[]
  employeeLoans            EmployeeLoan[]
  documents                EmployeeDocument[]
  performanceReviews       PerformanceReview[]
  serviceRequests          EmployeeServiceRequest[]
  payrollAdjustments       PayrollAdjustment[]
  taxDeclarations          TaxDeclaration[]
  form16Documents          Form16Document[]
  settlements              FullFinalSettlement[]
  onboarding               EmployeeOnboarding?
  attendanceLocationPoints AttendanceLocationPoint[]
  statutoryProfiles        EmployeeStatutoryProfile[]
  statutoryFilingItems     StatutoryFilingItem[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
  @@index([branchId])
  @@index([workLocationId])
  @@index([teamId])
  @@index([costCenterId])
  @@index([employeeGradeId])
  @@index([reportingManagerId])
}

model EmployeeOnboarding {
  id                String                   @id @default(uuid())
  companyId         String
  createdById       String
  employeeCode      String?
  workEmail         String?
  status            EmployeeOnboardingStatus @default(DRAFT)
  progress          Int                      @default(0)
  personalDetails   Json?
  documentDetails   Json?
  salaryDetails     Json?
  faceDetails       Json?
  additionalDetails Json?
  createdEmployeeId String?                  @unique
  rejectionReason   String?
  completedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdEmployee Employee? @relation(fields: [createdEmployeeId], references: [id])

  @@index([companyId, status, updatedAt])
  @@index([createdById])
}

enum FaceEnrollmentStatus {
  ACTIVE
  REVOKED
}

enum FaceVerificationStatus {
  CHALLENGE
  VERIFIED
  CONSUMED
  REJECTED
  EXPIRED
}

// A provider face identifier is retained instead of the employee's raw photo.
// Enrollment is tenant-scoped and can only be created by HR/Admin API roles.
model FaceEnrollment {
  id             String               @id @default(uuid())
  companyId      String
  employeeId     String               @unique
  provider       String               @default("AWS_REKOGNITION")
  providerFaceId String
  status         FaceEnrollmentStatus @default(ACTIVE)
  enrolledById   String
  enrolledAt     DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enrolledBy User     @relation("FaceEnrollmentCreator", fields: [enrolledById], references: [id])

  @@index([companyId, status])
}

// Short-lived server-side state prevents reusing a successful face check for a
// different employee, device, action or attendance punch.
model FaceVerificationSession {
  id             String                 @id @default(uuid())
  companyId      String
  employeeId     String
  action         String
  status         FaceVerificationStatus @default(CHALLENGE)
  deviceId       String
  proofTokenHash String?                @unique
  similarity     Float?
  attemptCount   Int                    @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime?
  consumedAt     DateTime?
  createdAt      DateTime               @default(now())
  ipAddress      String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status, expiresAt])
  @@index([companyId, createdAt])
}

// --------------------------------------------------------
// DEPARTMENTS & DESIGNATIONS
// --------------------------------------------------------
model Department {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  code           String
  headEmployeeId String?
  budget         Float    @default(0)
  location       String?
  description    String?
  createdAt      DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees    Employee[]
  designations Designation[]
  jobPostings  JobPosting[]
  teams        Team[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  name      String
  code      String
  legalName String?
  timezone  String   @default("Asia/Kolkata")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations WorkLocation[]
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, active])
}

model WorkLocation {
  id                   String   @id @default(uuid())
  companyId            String
  branchId             String?
  name                 String
  code                 String
  address              String?
  city                 String?
  state                String?
  country              String   @default("IN")
  latitude             Float?
  longitude            Float?
  geofenceRadiusMeters Int?
  remote               Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id])
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, branchId])
}

model Team {
  id                String   @id @default(uuid())
  companyId         String
  departmentId      String?
  name              String
  code              String
  managerEmployeeId String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([companyId, code])
  @@index([companyId, departmentId])
}

model CostCenter {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  code        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, code])
}

model EmployeeGrade {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  code        String
  rank        Int      @default(0)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, code])
}

model Permission {
  id          String   @id @default(uuid())
  companyId   String
  key         String
  description String?
  createdAt   DateTime @default(now())

  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions AccessRolePermission[]

  @@unique([companyId, key])
}

model AccessRole {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  code        String
  description String?
  system      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions AccessRolePermission[]
  grants          UserAccessGrant[]

  @@unique([companyId, code])
}

model AccessRolePermission {
  roleId       String
  permissionId String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserAccessGrant {
  id            String          @id @default(uuid())
  companyId     String
  userId        String
  roleId        String
  scope         PermissionScope @default(SELF)
  scopeEntityId String?
  createdAt     DateTime        @default(now())
  expiresAt     DateTime?

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope, scopeEntityId])
  @@index([companyId, userId])
}

model WorkflowDefinition {
  id          String                   @id @default(uuid())
  companyId   String
  module      WorkflowModule
  name        String
  code        String
  version     Int                      @default(1)
  status      WorkflowDefinitionStatus @default(DRAFT)
  criteria    Json?
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([companyId, code, version])
  @@index([companyId, module, status])
}

model WorkflowStep {
  id                String               @id @default(uuid())
  definitionId      String
  sequence          Int
  name              String
  approverType      WorkflowApproverType
  approverReference String?
  minimumApprovals  Int                  @default(1)
  slaHours          Int?
  allowDelegation   Boolean              @default(true)
  conditions        Json?

  definition    WorkflowDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  stepInstances WorkflowStepInstance[]

  @@unique([definitionId, sequence])
}

model WorkflowInstance {
  id              String                 @id @default(uuid())
  companyId       String
  definitionId    String
  module          WorkflowModule
  subjectType     String
  subjectId       String
  requesterUserId String
  status          WorkflowInstanceStatus @default(PENDING)
  currentSequence Int                    @default(1)
  title           String
  summary         String?
  payload         Json?
  submittedAt     DateTime               @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  definition    WorkflowDefinition     @relation(fields: [definitionId], references: [id])
  stepInstances WorkflowStepInstance[]
  actions       WorkflowAction[]

  @@unique([companyId, subjectType, subjectId])
  @@index([companyId, status, submittedAt])
  @@index([requesterUserId, status])
}

model WorkflowStepInstance {
  id               String             @id @default(uuid())
  instanceId       String
  stepId           String
  sequence         Int
  status           WorkflowStepStatus @default(WAITING)
  approverUserIds  String[]
  approvals        Int                @default(0)
  minimumApprovals Int                @default(1)
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step     WorkflowStep     @relation(fields: [stepId], references: [id])
  actions  WorkflowAction[]

  @@unique([instanceId, sequence])
  @@index([status, dueAt])
}

model WorkflowAction {
  id              String             @id @default(uuid())
  instanceId      String
  stepInstanceId  String?
  actorUserId     String
  actingForUserId String?
  action          WorkflowActionType
  comment         String?
  metadata        Json?
  createdAt       DateTime           @default(now())

  instance     WorkflowInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
