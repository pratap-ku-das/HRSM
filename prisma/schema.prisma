  @@index([companyId])
}

// --------------------------------------------------------
// EXPENSES & REIMBURSEMENTS
// --------------------------------------------------------
model ExpenseClaim {
  id           String        @id @default(uuid())
  companyId    String
  employeeId   String
  title        String
  category     String
  amount       Float
  currency     String        @default("INR")
  expenseDate  DateTime      @db.Date
  status       ExpenseStatus @default(PENDING)
  notes        String?
  approvedById String?
  approvedAt   DateTime?
  submittedAt  DateTime      @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model EmployeeServiceRequest {
  id String @id @default(uuid())
  companyId String
  employeeId String
  type String
  title String
  reason String
  amount Float?
  payload Json?
  status WorkflowInstanceStatus @default(PENDING)
  workflowInstanceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade)
  @@index([companyId,status])
  @@index([employeeId,createdAt])
}

// --------------------------------------------------------
// IMMUTABLE AUDIT TRAIL & SETTINGS
// --------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  userName  String
  userRole  String
  action    String
  category  String
  details   String
  timestamp DateTime @default(now())
  ipAddress String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, timestamp])
}

model CompanySettings {
  id                           String  @id @default(uuid())
  companyId                    String  @unique
  companyName                  String
  legalEntityName              String
  taxRegistrationNumber        String
  currency                     String  @default("INR")
  currencySymbol               String  @default("₹")
  timezone                     String  @default("UTC")
  workDays                     Int[]   @default([1, 2, 3, 4, 5])
  businessHoursStart           String  @default("09:00")
  businessHoursEnd             String  @default("18:00")
  enableAutomaticOvertime      Boolean @default(true)
  enableAuditLogging           Boolean @default(true)
  defaultProbationPeriodMonths Int     @default(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
