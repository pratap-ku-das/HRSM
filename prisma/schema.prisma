  endsAt    DateTime               @db.Date
  status    PerformanceCycleStatus @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviews   PerformanceReview[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model PerformanceReview {
  id               String                  @id @default(uuid())
  companyId        String
  cycleId          String
  employeeId       String
  reviewerId       String
  status           PerformanceReviewStatus @default(DRAFT)
  overallRating    Float?
  goalRating       Float?
  competencyRating Float?
  strengths        String?
  growthAreas      String?
  summary          String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle            PerformanceCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee         Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer         User                    @relation("PerformanceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([cycleId, employeeId])
  @@index([companyId, status])
  @@index([reviewerId, status])
}

// --------------------------------------------------------
// ASSETS & HARDWARE
// --------------------------------------------------------
model Asset {
  id                   String      @id @default(uuid())
  companyId            String
  name                 String
  category             String
  serialNumber         String
  assignedToEmployeeId String?
  assignedDate         DateTime?   @db.Date
  purchaseDate         DateTime    @db.Date
  purchaseCost         Float
  currency             String      @default("INR")
  status               AssetStatus @default(AVAILABLE)
  condition            String      @default("NEW")

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo Employee? @relation(fields: [assignedToEmployeeId], references: [id])

  @@unique([companyId, serialNumber])
  @@index([companyId])
}

// --------------------------------------------------------
// DOCUMENTS, HOLIDAYS & BROADCASTS
// --------------------------------------------------------
model CompanyDocument {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  category    String
  fileSize    String
  fileType    String
  downloadUrl String
  objectKey   String?
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model EmployeeDocument {
  id                 String                     @id @default(uuid())
  companyId          String
  employeeId         String
  documentType       String
  title              String
  objectKey          String
  fileName           String
  mimeType           String
  sizeBytes          Int
  issueDate          DateTime?                  @db.Date
  expiryDate         DateTime?                  @db.Date
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  retentionUntil     DateTime?                  @db.Date
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, expiryDate])
  @@index([employeeId, documentType])
}

model SavedReport {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  name      String
  reportKey String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
}

model ReportExport {
  id          String             @id @default(uuid())
  companyId   String
  userId      String
  reportKey   String
  format      String
  filters     Json
  status      ReportExportStatus @default(PENDING)
  rowCount    Int?
  objectKey   String?
  error       String?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  completedAt DateTime?
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  companyId String?
  email     String
  userId    String?
  success   Boolean
  reason    String?
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([companyId, createdAt])
}

model MfaMethod {
  id              String    @id @default(uuid())
  userId          String    @unique
  encryptedSecret String
  enabled         Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiInteraction {
  id             String   @id @default(uuid())
  companyId      String
  userId         String
  prompt         String
  intent         String
  answer         String
  sources        Json
  proposedAction Json?
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model Holiday {
  id        String   @id @default(uuid())
  companyId String
  name      String
  date      DateTime @db.Date
  type      String   @default("NATIONAL")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Announcement {
  id         String   @id @default(uuid())
  companyId  String
  title      String
  content    String
  priority   String   @default("NORMAL")
  authorName String
  authorRole String
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// --------------------------------------------------------
// EXPENSES & REIMBURSEMENTS
// --------------------------------------------------------
model ExpenseClaim {
  id           String        @id @default(uuid())
  companyId    String
  employeeId   String
  title        String
  category     String
  amount       Float
  currency     String        @default("INR")
  expenseDate  DateTime      @db.Date
  status       ExpenseStatus @default(PENDING)
  notes        String?
  approvedById      String?
  approvedAt        DateTime?
  submittedAt       DateTime           @default(now())
  reimbursedAt      DateTime?
  payrollAdjustment PayrollAdjustment?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model EmployeeServiceRequest {
  id                 String                 @id @default(uuid())
  companyId          String
  employeeId         String
  type               String
  title              String
  reason             String
  amount             Float?
  payload            Json?
  status             WorkflowInstanceStatus @default(PENDING)
  workflowInstanceId String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([employeeId, createdAt])
}

// --------------------------------------------------------
// IMMUTABLE AUDIT TRAIL & SETTINGS
// --------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  userName  String
  userRole  String
  action    String
  category  String
  details   String
  timestamp DateTime @default(now())
  ipAddress String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, timestamp])
}

model CompanySettings {
  id                           String    @id @default(uuid())
  companyId                    String    @unique
  companyName                  String
  legalEntityName              String
  taxRegistrationNumber        String
  companyType                  String    @default("PRIVATE_LIMITED")
  registrationNumber           String    @default("")
  incorporationDate            DateTime? @db.Date
  panNumber                    String    @default("")
  tanNumber                    String    @default("")
  udyamRegistrationNumber      String    @default("")
  pfRegistrationNumber         String    @default("")
  esiRegistrationNumber        String    @default("")
  professionalTaxNumber        String    @default("")
  labourLicenseNumber          String    @default("")
  officialEmail                String    @default("")
  officialPhone                String    @default("")
  website                      String    @default("")
  registeredAddress            String    @default("")
  city                         String    @default("")
  state                        String    @default("")
  country                      String    @default("India")
  postalCode                   String    @default("")
  industry                     String    @default("")
  companySize                  String    @default("")
  financialYearStartMonth      Int       @default(4)
  currency                     String    @default("INR")
  currencySymbol               String    @default("₹")
  timezone                     String    @default("UTC")
  workDays                     Int[]     @default([1, 2, 3, 4, 5])
  businessHoursStart           String    @default("09:00")
  businessHoursEnd             String    @default("18:00")
  enableAutomaticOvertime      Boolean   @default(true)
  enableAuditLogging           Boolean   @default(true)
  defaultProbationPeriodMonths Int       @default(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// STATUTORY COMPLIANCE & GOVERNMENT FILING (P2.7-A)
// --------------------------------------------------------

model EmployeeStatutoryProfile {
  id            String    @id @default(uuid())
  companyId     String
  employeeId    String
  uan           String?   @db.VarChar(12)
  pfMemberId    String?   @db.VarChar(50)
  esicIpNumber  String?   @db.VarChar(10)
  panNumber     String?   @db.VarChar(10)
  epsExempt     Boolean   @default(false)
  pfOptOut      Boolean   @default(false)
  ptState       String?   @db.VarChar(2)
  effectiveFrom DateTime  @default(now()) @db.Date
  effectiveTo   DateTime? @db.Date
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId, employeeId, active])
  @@index([companyId, employeeId, effectiveFrom])
  @@index([companyId, uan])
  @@index([companyId, panNumber])
}

model TdsChallan {
  id                String           @id @default(uuid())
  companyId         String
  financialYear     String
  quarter           String
  bsrCode           String           @db.VarChar(7)
  challanDate       DateTime         @db.Date
  challanSerialNo   String           @db.VarChar(5)
  minorHead         String           @default("200")
  tdsAmount         Float
  surcharge         Float            @default(0)
  cess              Float            @default(0)
  interest          Float            @default(0)
  fee               Float            @default(0)
  totalAmount       Float
  chequeOrDdNo      String?
  statutoryFilingId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  filing  StatutoryFiling? @relation(fields: [statutoryFilingId], references: [id], onDelete: SetNull)

  @@unique([companyId, bsrCode, challanDate, challanSerialNo])
  @@index([companyId, financialYear, quarter])
  @@index([statutoryFilingId])
}

model StatutoryFiling {
  id                 String                @id @default(uuid())
  companyId          String
  domain             StatutoryFilingDomain
  filingType         StatutoryFilingType   @default(ORIGINAL)
  periodYear         Int
  periodMonth        Int?
  quarter            String?
  stateCode          String?
  payrollRunId       String
  status             StatutoryFilingStatus @default(DRAFT)
  
  totalEmployees     Int                   @default(0)
  totalGrossWages    Float                 @default(0)
  totalEpfWages      Float                 @default(0)
  totalEeShare       Float                 @default(0)
  totalErShare       Float                 @default(0)
  totalTaxDeducted   Float                 @default(0)
  
  sha256Checksum     String?
  supersededFilingId String?
  createdById        String
  validatedAt        DateTime?
  approvedById       String?
  approvedAt         DateTime?
  lockedAt           DateTime?
  rejectionReason    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun            @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  items      StatutoryFilingItem[]
  challans   TdsChallan[]

  @@unique([companyId, domain, periodYear, periodMonth, quarter, stateCode, filingType])
  @@index([companyId, domain, periodYear])
  @@index([payrollRunId])
}

model StatutoryFilingItem {
  id                   String          @id @default(uuid())
  filingId             String
  employeeId           String
  
  snapshotEmployeeCode String
  snapshotEmployeeName String
  snapshotUan          String?
  snapshotPan          String?
  snapshotEsicIp       String?
  
  workingDays          Float           @default(0)
  payableDays          Float           @default(0)
  ncpDays              Float           @default(0)
  
  grossWages           Float           @default(0)
  epfWages             Float           @default(0)
  epsWages             Float           @default(0)
  edliWages            Float           @default(0)
  eePfShare            Float           @default(0)
  erEpsShare           Float           @default(0)
  erEpfShare           Float           @default(0)
  eeEsiShare           Float           @default(0)
  erEsiShare           Float           @default(0)
  ptAmount             Float           @default(0)
  tdsAmount            Float           @default(0)
  
  calculationDetails   Json?
  createdAt            DateTime        @default(now())

  filing   StatutoryFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([filingId, employeeId])
  @@index([filingId])
  @@index([employeeId])
}

