// Prisma Schema for Multi-Tenant Enterprise HRMS
// Connected to Supabase PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  DEPT_HEAD
  EMPLOYEE
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_PROBATION
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceSource {
  WEB_ADMIN
  MOBILE_FACE
  BIOMETRIC_DEVICE
  SYSTEM_AUTO
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum JobStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  AT_RISK
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

// --------------------------------------------------------
// MULTI-TENANT COMPANY / WORKSPACE
// --------------------------------------------------------
model Company {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  email       String
  phone       String?
  address     String?
  industry    String
  size        String
  plan        PlanTier  @default(GROWTH)
  logoUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users             User[]
  employees         Employee[]
  departments       Department[]
  designations      Designation[]
  attendanceRecords AttendanceRecord[]
  leaveTypes        LeaveType[]
  leaveRequests     LeaveRequest[]
  payrollRuns       PayrollRun[]
  payslips          Payslip[]
  jobPostings       JobPosting[]
  jobApplicants     JobApplicant[]
  goals             PerformanceGoal[]
  assets            Asset[]
  documents         CompanyDocument[]
  holidays          Holiday[]
  announcements     Announcement[]
  expenses          ExpenseClaim[]
  auditLogs         AuditLog[]
  settings          CompanySettings?
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------
model User {
  id           String    @id @default(uuid())
  companyId    String
  email        String    @unique
  passwordHash String?
  fullName     String
  role         UserRole  @default(COMPANY_ADMIN)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee?

  @@index([companyId])
}

// --------------------------------------------------------
// EMPLOYEE PROFILE (360-DEGREE LIFECYCLE)
// --------------------------------------------------------
model Employee {
  id                 String          @id @default(uuid())
  companyId          String
  userId             String?         @unique
  employeeCode       String
  firstName          String
  lastName           String
  email              String
  phone              String?
  avatarUrl          String?
  dateOfBirth        DateTime?       @db.Date
  gender             String?
  departmentId       String
  designationId      String
  reportingManagerId String?
  dateOfJoining      DateTime        @db.Date
  employmentType     EmploymentType  @default(FULL_TIME)
  status             EmployeeStatus  @default(ACTIVE)
  workLocation       String?

  // Compensation breakdown
  basicSalary        Float           @default(0)
  hra                Float           @default(0)
  allowances         Float           @default(0)
  providentFund      Float           @default(0)
  taxDeduction       Float           @default(0)
  currency           String          @default("INR")

  // Bank & Tax
  bankName           String?
  accountNumber      String?
  routingOrIfsc      String?
  taxIdentifier      String?

  // Emergency contact
  emergencyName      String?
  emergencyRelation  String?
  emergencyPhone     String?

  skills             String[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id])
  department         Department      @relation(fields: [departmentId], references: [id])
  designation        Designation     @relation(fields: [designationId], references: [id])
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  payslips           Payslip[]
  goals              PerformanceGoal[]
  assets             Asset[]
  expenses           ExpenseClaim[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
}

// --------------------------------------------------------
// DEPARTMENTS & DESIGNATIONS
// --------------------------------------------------------
model Department {
  id             String        @id @default(uuid())
  companyId      String
  name           String
  code           String
  headEmployeeId String?
  budget         Float         @default(0)
  location       String?
  description    String?
  createdAt      DateTime      @default(now())

  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees      Employee[]
  designations   Designation[]
  jobPostings    JobPosting[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Designation {
  id           String      @id @default(uuid())
  companyId    String
  departmentId String
  title        String
  gradeLevel   String      @default("L3")
  minSalary    Float       @default(0)
  maxSalary    Float       @default(0)
  description  String?
  createdAt    DateTime    @default(now())

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@index([companyId])
}

// --------------------------------------------------------
// ATTENDANCE (FUTURE-PROOF WITH PHASE 6 MOBILE FACE-AUTH)
// --------------------------------------------------------
model AttendanceRecord {
  id                  String           @id @default(uuid())
  companyId           String
  employeeId          String
  date                DateTime         @db.Date
  status              AttendanceStatus @default(PRESENT)

  // Future Mobile Face-Auth & Biometrics (Ready for Phase 6)
  clockInTime         DateTime?
  clockOutTime        DateTime?
  clockInPhotoUrl     String?
  clockOutPhotoUrl    String?
  faceAuthVerified    Boolean          @default(false)
  faceConfidenceScore Float?
  deviceId            String?
  locationLat         Float?
  locationLng         Float?
  source              AttendanceSource @default(WEB_ADMIN)

  // Web Admin manual adjustments
  correctionNote      String?
  correctedBy         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([companyId, date])
}

// --------------------------------------------------------
// LEAVE MANAGEMENT
// --------------------------------------------------------
model LeaveType {
  id                 String         @id @default(uuid())
  companyId          String
  name               String
  code               String
  daysAllowedPerYear Int            @default(20)
  isPaid             Boolean        @default(true)
  color              String         @default("#3b82f6")

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveRequests      LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
}

model LeaveRequest {
  id              String       @id @default(uuid())
  companyId       String
  employeeId      String
  leaveTypeId     String
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  totalDays       Float
  reason          String
  status          LeaveStatus  @default(PENDING)
  approvedBy      String?
  reviewerComment String?
  appliedAt       DateTime     @default(now())

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

// --------------------------------------------------------
// PAYROLL & COMPENSATION
// --------------------------------------------------------
model PayrollRun {
  id               String        @id @default(uuid())
  companyId        String
  month            String        // YYYY-MM
  status           PayrollStatus @default(DRAFT)
  totalEmployees   Int
  totalGrossSalary Float
  totalDeductions  Float
  totalNetPayout   Float
  processedDate    DateTime?
  createdAt        DateTime      @default(now())

  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslips         Payslip[]

  @@unique([companyId, month])
  @@index([companyId])
}

model Payslip {
  id              String      @id @default(uuid())
  companyId       String
  payrollRunId    String
  employeeId      String
  month           String      // YYYY-MM
  basicSalary     Float
  hra             Float
  allowances      Float
  grossSalary     Float
  providentFund   Float
  taxDeductions   Float
  otherDeductions Float       @default(0)
  totalDeductions Float
  netSalary       Float
  workingDays     Int
  presentDays     Int
  paidLeaveDays   Int
  unpaidDays      Int         @default(0)
  status          String      @default("PAID")
  paymentDate     DateTime?   @db.Date

  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollRun      PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([companyId])
}

// --------------------------------------------------------
// RECRUITMENT ATS
// --------------------------------------------------------
model JobPosting {
  id              String         @id @default(uuid())
  companyId       String
  departmentId    String
  title           String
  location        String
  employmentType  EmploymentType @default(FULL_TIME)
  experienceLevel String
  minSalary       Float
  maxSalary       Float
  currency        String         @default("INR")
  status          JobStatus      @default(OPEN)
  description     String
  requirements    String[]
  applicantCount  Int            @default(0)
  postedAt        DateTime       @default(now())

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department     @relation(fields: [departmentId], references: [id])
  applicants      JobApplicant[]

  @@index([companyId])
}

model JobApplicant {
  id              String      @id @default(uuid())
  companyId       String
  jobPostingId    String
  fullName        String
  email           String
  phone           String?
  currentCompany  String?
  experienceYears Float       @default(0)
  stage           JobStage    @default(APPLIED)
  rating          Int         @default(5)
  notes           String?
  appliedAt       DateTime    @default(now())

  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPosting      JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([jobPostingId])
}

// --------------------------------------------------------
// PERFORMANCE GOALS & REVIEWS
// --------------------------------------------------------
model PerformanceGoal {
  id          String     @id @default(uuid())
  companyId   String
  employeeId  String
  title       String
  description String?
  category    String     @default("OKR")
  targetDate  DateTime   @db.Date
  progress    Float      @default(0)
  status      GoalStatus @default(IN_PROGRESS)
  createdAt   DateTime   @default(now())

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
}

// --------------------------------------------------------
// ASSETS & HARDWARE
// --------------------------------------------------------
model Asset {
  id                   String      @id @default(uuid())
  companyId            String
  name                 String
  category             String
  serialNumber         String
  assignedToEmployeeId String?
  assignedDate         DateTime?   @db.Date
  purchaseDate         DateTime    @db.Date
  purchaseCost         Float
  currency             String      @default("INR")
  status               AssetStatus @default(AVAILABLE)
  condition            String      @default("NEW")

  company              Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo           Employee?   @relation(fields: [assignedToEmployeeId], references: [id])

  @@unique([companyId, serialNumber])
  @@index([companyId])
}

// --------------------------------------------------------
// DOCUMENTS, HOLIDAYS & BROADCASTS
// --------------------------------------------------------
model CompanyDocument {
  id         String   @id @default(uuid())
  companyId  String
  title      String
  category   String
  fileSize   String
  fileType   String
  downloadUrl String
  uploadedAt DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Holiday {
  id        String   @id @default(uuid())
  companyId String
  name      String
  date      DateTime @db.Date
  type      String   @default("NATIONAL")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Announcement {
  id         String   @id @default(uuid())
  companyId  String
  title      String
  content    String
  priority   String   @default("NORMAL")
  authorName String
  authorRole String
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// --------------------------------------------------------
// EXPENSES & REIMBURSEMENTS
// --------------------------------------------------------
model ExpenseClaim {
  id          String        @id @default(uuid())
  companyId   String
  employeeId  String
  title       String
  category    String
  amount      Float
  currency    String        @default("INR")
  expenseDate DateTime      @db.Date
  status      ExpenseStatus @default(PENDING)
  notes       String?
  submittedAt DateTime      @default(now())

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// --------------------------------------------------------
// IMMUTABLE AUDIT TRAIL & SETTINGS
// --------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  userName  String
  userRole  String
  action    String
  category  String
  details   String
  timestamp DateTime @default(now())
  ipAddress String

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, timestamp])
}

model CompanySettings {
  id                           String   @id @default(uuid())
  companyId                    String   @unique
  companyName                  String
  legalEntityName              String
  taxRegistrationNumber        String
  currency                     String   @default("INR")
  currencySymbol               String   @default("₹")
  timezone                     String   @default("UTC")
  workDays                     Int[]    @default([1, 2, 3, 4, 5])
  businessHoursStart           String   @default("09:00")
  businessHoursEnd             String   @default("18:00")
  enableAutomaticOvertime      Boolean  @default(true)
  enableAuditLogging           Boolean  @default(true)
  defaultProbationPeriodMonths Int      @default(3)

  company                      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
