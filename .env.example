# Server-only AWS RDS PostgreSQL connection. URL-encode special characters in DB_PASSWORD.
DB_HOST="hrms-database.cdc6cyayy6za.eu-north-1.rds.amazonaws.com"
DB_PORT="5432"
DB_NAME="hrms"
DB_USER="hrmsadmin"
DB_PASSWORD="YOUR_RDS_PASSWORD"
DATABASE_URL="postgresql://hrmsadmin:YOUR_RDS_PASSWORD@hrms-database.cdc6cyayy6za.eu-north-1.rds.amazonaws.com:5432/hrms?sslmode=require&connect_timeout=10&pool_timeout=10"
PORT=3001
JWT_ACCESS_SECRET="replace_with_at_least_32_random_characters"
JWT_ISSUER="orbithr-api"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="OrbitHR"
EMAIL_FROM="OrbitHR <onboarding@your-domain.com>"
ANDROID_APP_DOWNLOAD_URL="https://hr.balajione.dev/downloads/orbithr-android.apk"
WEB_APP_URL="https://hr.balajione.dev"
